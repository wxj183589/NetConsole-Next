    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <EmbeddedResource Include="../../storage/schema_v1.sql" LogicalName="schema_v1.sql" />
    <EmbeddedResource Include="../../storage/schema_v2.sql" LogicalName="schema_v2.sql" />
    <EmbeddedResource Include="../../storage/schema_v3.sql" LogicalName="schema_v3.sql" />
    <EmbeddedResource Include="../../storage/schema_v4.sql" LogicalName="schema_v4.sql" />
  </ItemGroup>
</Project>
