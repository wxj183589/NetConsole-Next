{
  "name": "netconsole-next-web",
  "private": true,
  "version": "0.1.0",
  "description": "NetConsole Next offline Vue web UI and terminal assets",
  "type": "module",
  "scripts": {
    "build": "vite build && node build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/xterm": "5.5.0",
    "echarts": "6.0.0",
    "element-plus": "2.11.5",
    "pinia": "3.0.3",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "esbuild": "0.25.12",
    "happy-dom": "15.11.7",
    "playwright": "1.64.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
